{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "",
    "buildCommand": "node tools/stamp.js",
    "outputDirectory": "src",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'none'"
                }
            ]
        }
    ]
}
